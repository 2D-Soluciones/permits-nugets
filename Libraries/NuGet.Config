<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="MetaPackages" value=".\nugets" />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>

	<!--
		En el arbol recortado no queda ninguna PackageReference a DDS.*: las librerias se referencian
		entre si por ProjectReference. El mapeo se deja igual para cuando se vuelvan a publicar los
		paquetes: sin el, un ./nugets vacio (que es el estado de un clon fresco, porque esta
		gitignoreado) hace que restore se caiga a nuget.org a buscar DDS.General, que es la
		sustitucion por confusion de dependencias de manual. Cualquier feed privado adicional
		necesita su propia entrada aca.
	-->
	<packageSourceMapping>
		<packageSource key="MetaPackages">
			<package pattern="DDS.*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
