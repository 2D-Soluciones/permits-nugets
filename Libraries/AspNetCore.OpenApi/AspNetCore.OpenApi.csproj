<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>DDS OpenApi extensions for aspnetcore.</Description>
        <AssemblyName>DDS.AspNetCore.OpenApi</AssemblyName>
        <RootNamespace>$(AssemblyName)</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AspNetCore\AspNetCore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="FodyWeavers.xml"/>
        <None Remove="AspNetCore.Swagger.csproj.DotSettings"/>
        <None Remove="AspNetCore.OpenApi.csproj.DotSettings"/>
    </ItemGroup>

    <Import Project="..\copypackages.targets"/>
</Project>
